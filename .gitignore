# 密钥与本地配置
.env
.env.*
!.env.example

# 运行时数据：日志、缓存、备份
logs/
*.log
data/backups/
data/model-settings.json
data/task-history-*.json
*.sqlite
*.sqlite3
*.db

# 评测报告与界面截图要进仓库（它们是证据），只忽略临时产物
!data/evaluation.json
!data/*.png

# 语音与录制产物
recordings/
*.wav
*.webm

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# pytest 临时残渣（Windows 下临时目录权限受保护，删不掉时至少别提交）
pytest-of-*/
pytest-cache-files-*/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
